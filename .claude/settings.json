{
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "core@follow39": true,
    "sdd@follow39": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "follow39": {
      "source": {
        "source": "github",
        "repo": "follow39/claude-plugins"
      },
      "autoUpdate": true
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "pluginConfigs": {
    "sdd@follow39": {
      "options": {
        "specs_dir": "docs/specs",
        "designs_dir": "docs/designs",
        "data_dir": "~/.local/share/sdd",
        "worktrees_dir": ".worktrees"
      }
    }
  },
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "statusLine": {
    "type": "command",
    "command": "d=$(python3 -c 'import json,sys;print(json.load(sys.stdin)[\"workspace\"][\"current_dir\"])' 2>/dev/null) && cd \"$d\" 2>/dev/null && c=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0; [ \"$c\" = \"$(git rev-parse --path-format=absolute --git-dir)\" ] || w=' (worktree)'; printf '%s  %s%s' \"$(basename \"${c%/.git}\")\" \"$(git branch --show-current)\" \"$w\""
  },
  "theme": "dark"
}
