        "plans_dir": "~/.local/share/sdd/plans"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "theme": "dark",
  "voiceEnabled": true
